# ══════════════════════════════════════════════════════════════════════════
#  CarimarShow — variables de entorno
# ══════════════════════════════════════════════════════════════════════════
#
#  Este archivo es una PLANTILLA. Cópialo a `.env` y rellena tus valores:
#
#      cp .env.example .env
#
#  ⚠️  `.env` está en `.gitignore`. NO lo subas nunca a un repositorio.
#  ⚠️  Si alguna vez pegas un token en un chat, un issue o un commit,
#      considéralo COMPROMETIDO y revócalo de inmediato.
#
#  El script `scripts/run.sh` lee este archivo y lo inyecta como
#  `--dart-define`, que es la forma segura de pasar configuración a Flutter
#  (se compila dentro del binario, nunca queda en un asset legible).
#
#  Todos los valores son OPCIONALES: sin ellos la app arranca en
#  «modo demo» con un catálogo local y sin cuentas de usuario.
# ══════════════════════════════════════════════════════════════════════════

# ── TMDB (obligatorio para catálogo real) ────────────────────────────────
# Consíguelo gratis en https://www.themoviedb.org/settings/api
# Usa el "API Read Access Token" (el largo, v4). Es más seguro que el api_key
# porque viaja en una cabecera y no en la URL.
TMDB_READ_TOKEN=
# Idioma e imagen por defecto. es-ES | es-MX | en-US ...
TMDB_LANGUAGE=es-ES
TMDB_REGION=ES

# ── Supabase (opcional: habilita registro, login y «mi lista» sincronizada)
# Dashboard → Settings → API
#
# Usa la clave PÚBLICA (publishable / anon). NUNCA la `secret key`:
# esta clave va empaquetada dentro de la app, así que es pública por diseño.
# Lo que protege los datos de cada usuario son las políticas RLS que crea
# supabase/migrations/0001_initial_schema.sql.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alias heredado. Si defines las dos, manda SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
